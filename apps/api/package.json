{
  "name": "@allergy-platform/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@allergy-platform/shared": "workspace:*",
    "@fastify/cors": "^11",
    "@fastify/jwt": "^9",
    "@fastify/swagger": "^9",
    "@fastify/swagger-ui": "^5",
    "@prisma/client": "^5",
    "dotenv": "^16",
    "fastify": "^5",
    "jose": "^6.2.3",
    "zod": "^3"
  },
  "devDependencies": {
    "prisma": "^5",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^1"
  }
}
